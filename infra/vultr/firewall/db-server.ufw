# YantraGO — DB Server Firewall Rules (UFW)
# Apply with: sudo bash -c "cat firewall/db-server.ufw | while read line; do eval \$line; done"
# Or manually run each command.

# Reset UFW
ufw --force reset

# Default policies
ufw default deny incoming
ufw default allow outgoing

# SSH (restrict to admin IP if possible)
ufw allow from ${ADMIN_IP:-0.0.0.0/0} to any port 22 proto tcp

# PostgreSQL — only from internal network (app + gateway servers)
ufw allow from ${APP_SERVER_IP:-10.0.0.0/8} to any port 5432 proto tcp
ufw allow from ${GATEWAY_SERVER_IP:-10.0.0.0/8} to any port 5432 proto tcp

# Enable
ufw --force enable
ufw status verbose
