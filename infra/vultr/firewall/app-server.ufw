# YantraGO — App Server Firewall Rules (UFW)
# Apply with: ADMIN_IP=1.2.3.4 sudo -E bash firewall/app-server.ufw
# NOTE: run as a script — do NOT eval line-by-line (contains multi-line if blocks).

# Reset UFW
ufw --force reset

# Default policies
ufw default deny incoming
ufw default allow outgoing

# SSH — SEC-17: fail closed if ADMIN_IP is not set
if [ -z "${ADMIN_IP:-}" ]; then
    echo "ERROR: ADMIN_IP is required. Set it to the admin workstation IP."
    exit 1
fi
ufw allow from ${ADMIN_IP} to any port 22 proto tcp

# HTTP/HTTPS (public — Nginx reverse proxy)
ufw allow 80/tcp
ufw allow 443/tcp

# Backend API (internal only — Nginx proxies to it)
ufw allow from 127.0.0.1 to any port 8080 proto tcp

# Admin Web (internal only — Nginx proxies to it)
ufw allow from 127.0.0.1 to any port 3001 proto tcp

# Enable
ufw --force enable
ufw status verbose
