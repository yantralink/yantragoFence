{
  "annotations": { "list": [] },
  "title": "Gateway Metrics",
  "uid": "gateway-metrics",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["yantrago", "gateway"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "TCP Active Connections",
      "type": "graph",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "tcp_active_connections", "legendFormat": "Concox" },
        { "expr": "fencing_tcp_active_connections", "legendFormat": "Fencing" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "TCP Packets Processed",
      "type": "graph",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "rate(tcp_packets_processed_total[1m])", "legendFormat": "Concox" },
        { "expr": "rate(fencing_tcp_packets_processed_total[1m])", "legendFormat": "Fencing" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Gateway JVM Memory",
      "type": "graph",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "jvm_memory_used_bytes{service=\"gateway\", area=\"heap\"}", "legendFormat": "{{id}}" }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ]
}
